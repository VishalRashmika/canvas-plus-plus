# ==========================================
# Canvas++ (.gitignore)
# ==========================================

# --- Build & Output Artifacts ---
# main.js is generated by esbuild (npm run build / npm run dev)
main.js
*.map
*.js.map
dist/
build/
out/
*.tsbuildinfo

# --- Dependencies ---
node_modules/

# --- Logs & Package Manager Artifacts ---
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
.pnpm-store/
.npm/

# --- Testing & Coverage ---
coverage/
.nyc_output/
*.lcov

# --- Obsidian Vault & Testing Artifacts ---
# Created when the project root is opened directly inside an Obsidian vault
.obsidian/
.trash/

# --- Plugin Runtime & Agent Bridges ---
# Local runtime folders for Antigravity AI patches and RAG export bundles
.umlcanvas-patches/
.umlcanvas-rag/

# --- Environment & Secrets ---
.env
.env.local
.env.*.local
*.pem
*.key

# --- Caches & Tooling ---
.eslintcache
.cache/
.parcel-cache/
.temp/
tmp/

# --- IDE & Editor Artifacts ---
# VS Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.code-workspace

# JetBrains / IntelliJ / WebStorm
.idea/
*.iml
*.iws
*.ipr

# Cursor & other editors
.cursor/
.history/
*.sublime-workspace
*.sublime-project
*.swp
*.swo
*~

# --- Operating System Files ---
# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
Desktop.ini
$RECYCLE.BIN/

# Linux
.directory
.fuse_hidden*
.nfs*
