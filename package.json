  "author": "J.M. Vishal Rashmika Perera",
  "license": "GPL-3.0-only",
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "@types/node": "^20.11.30",
    "esbuild": "^0.20.2",
    "eslint": "^9.39.5",
    "eslint-plugin-obsidianmd": "^0.4.2",
    "jest": "^29.7.0",
    "obsidian": "latest",
    "ts-jest": "^29.1.2",
    "tslib": "^2.6.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.0"
  }
}
