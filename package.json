{
  "name": "canvas-plus-plus",
  "version": "2.0.8",
  "description": "Professional UML 2.x diagrams, hardware schematics, and freehand shape recognition on a high-performance visual canvas with AI coding agent integration.",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "test": "jest",
    "test:watch": "jest --watch",
    "lint": "eslint src"
  },
  "keywords": [
    "canvas",
    "canvas-plus-plus",
    "uml",
    "schematic",
    "diagramming",
    "whiteboard",
    "obsidian-plugin"
